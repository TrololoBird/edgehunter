[Unit]
Description=Farside spot-ETF flows + NYSE calendar for the bot's shadow features (one request a day)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pump
WorkingDirectory=/opt/pump
ExecStart=/opt/pump/.venv/bin/python tools/farside_flows.py --out-dir /opt/pump
Nice=10
TimeoutStartSec=120
MemoryMax=400M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/pump
ProtectHome=yes
PrivateTmp=yes
