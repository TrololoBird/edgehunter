[Unit]
Description=Farside spot-ETF flows + NYSE calendar for the bot's shadow features (one request a day)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=edgehunter
WorkingDirectory=/opt/edgehunter
ExecStart=/opt/edgehunter/.venv/bin/python tools/farside_flows.py --out-dir /opt/edgehunter
Nice=10
TimeoutStartSec=120
MemoryMax=400M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/edgehunter
ProtectHome=yes
PrivateTmp=yes
